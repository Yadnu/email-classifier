      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(classifier_confidence_bucket[5m])) by (le))",
          "legendFormat": "confidence p50"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(classifier_spam_probability_bucket[5m])) by (le))",
          "legendFormat": "spam_probability p50"
        }
      ]
    }
