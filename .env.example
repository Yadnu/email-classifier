# Copy this file to .env and fill in values.
#   copy .env.example .env
# .env is gitignored and must never be committed.

# ── TypeSafe / Jev (required for classify, evaluate, and POST /classify) ──
# Create a key at https://typesafe.ai
# The SDK also reads TYPESAFE_API_KEY from the process environment.
TYPESAFE_API_KEY=

# Optional. Override the default model (we pin jev-1.13.0 in code/config).
# TYPESAFE_DEFAULT_MODEL=jev-1.13.0

# ── App ───────────────────────────────────────────────────────────────────
# Optional. Path to config.yaml (thresholds, ingest, pricing).
# CLASSIFIER_CONFIG=config.yaml

# ── Observability (Stage 4) ───────────────────────────────────────────────
# OTLP gRPC endpoint for the collector in deploy/docker-compose.yml
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Gmail (not env vars) ──────────────────────────────────────────────────
# OAuth Desktop client JSON from Google Cloud Console:
#   data/credentials.json
# Token written on first `email-classifier ingest`:
#   data/token.json
# SQLite mailbox + classifications:
#   data/classifier.db
#
# Ingest does not need TYPESAFE_API_KEY:
#   uv run email-classifier ingest
#
# Classify a message after ingest:
#   uv run email-classifier classify <message_id>
